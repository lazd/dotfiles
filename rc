# emacs shortcuts
set -o emacs

# style
zmodload zsh/nearcolor
zstyle :prompt:pure:path color magenta
zstyle ':prompt:pure:prompt:success' color green
zstyle ':prompt:pure:prompt:error' color red

# prompt
fpath+=("$HOME/.zsh/pure")
autoload -U promptinit
promptinit
prompt pure

# subfiles
DOTFILESDIR=$(dirname "$0")/rcs
source ${DOTFILESDIR}/dev
source ${DOTFILESDIR}/git
source ${DOTFILESDIR}/hz
source ${DOTFILESDIR}/nodenpm
