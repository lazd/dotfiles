if [ -n "${BASH_VERSION:-}" ]; then
	DOTFILESDIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/rcs
else
	DOTFILESDIR="${${(%):-%x}:A:h}/rcs"
fi
source "$DOTFILESDIR/../profile"

# emacs shortcuts
set -o emacs

# prompt
export STARSHIP_CONFIG="$DOTFILESDIR/../starship.toml"
if [[ $- == *i* ]]; then
	if [ -n "${ZSH_VERSION:-}" ] && [ -f "$HOME/.pure-enabled" ] &&
		[ -f "$HOME/.pure/pure.zsh" ]; then
		prompt_pure_precustom() {
			psvar[22]='💻'
			if [ -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}${PROMPT_PURE_SSH_CONNECTION:-}" ]; then
				psvar[22]='☁️'
			fi
		}
		fpath=("$HOME/.pure" $fpath)
		autoload -U promptinit
		promptinit
		prompt pure
		zmodload zsh/nearcolor
		zstyle :prompt:pure:path color magenta
		zstyle ':prompt:pure:prompt:success' color green
		zstyle ':prompt:pure:prompt:error' color red
	elif command -v starship >/dev/null 2>&1; then
		if [ -n "${ZSH_VERSION:-}" ]; then
			eval "$(starship init zsh)"
		else
			eval "$(starship init bash)"
		fi
	fi
fi

# subfiles
source "$DOTFILESDIR/basic"
source "$DOTFILESDIR/dev"
source "$DOTFILESDIR/git"
source "$DOTFILESDIR/hz"
source "$DOTFILESDIR/nodenpm"
