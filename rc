if [ -n "${BASH_VERSION:-}" ]; then
	DOTFILESDIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/rcs
else
	DOTFILESDIR="${${(%):-%x}:A:h}/rcs"
fi
source "$DOTFILESDIR/../profile"

# emacs shortcuts
set -o emacs

# prompt
if [[ $- == *i* ]] && command -v starship >/dev/null 2>&1; then
	if [ -n "${ZSH_VERSION:-}" ]; then
		eval "$(starship init zsh)"
	else
		eval "$(starship init bash)"
	fi
fi

# subfiles
source "$DOTFILESDIR/basic"
source "$DOTFILESDIR/dev"
source "$DOTFILESDIR/git"
source "$DOTFILESDIR/hz"
source "$DOTFILESDIR/nodenpm"
