[core]
  editor = vim
  autocrlf = input
  pager = delta
  hooksPath = /Users/lazd/.config/git/hooks
[alias]
  co = checkout
  br = branch
  ci = commit
  st = status
  p = push
[color]
  ui = true
[pack]
  windowMemory = 4096m
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
[merge]
  conflictStyle = zdiff3
