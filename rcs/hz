# Where's the repo?
HZREPO=~/repos/hz
if [[ ! -d "$HZREPO" ]]; then
  if [[ -d ~/hz ]]; then
    HZREPO=~/hz
  else
    echo "🛑 hz repo not checked out in expected location"
  fi
fi

# ssh fix
export NODE_EXTRA_CA_CERTS="$HZREPO/tools/build/ssl/ca.pem"

alias update-npm="hz update npm"

alias update-and-gen="update-npm && gen-bazel-build"

function bulldozer() {
  cd $HZREPO
  ./tools/buildozer 'remove data' //common/bazel:%workspace_files
}

function gen-bazel-build() {
  cd $HZREPO
  ./bin/generate-bazel-build.sh
  cd -
}

function storybook() {
  bazel run :storybook --watch
}

# Find codeowners
function codeowners() {
  bazel run //:codeowners
}

# Update green tag
function gfg() {
  # git fetch origin green
  git fetch origin refs/tags/green:refs/tags/green --force
}

# Update your branch from green
function gug() {
  gfg
  git merge green
}

# Create a new branch from green
function gbg() {
  gfg
  git checkout -b $1 green --no-track
}

function cleandevserver() {
  bazel clean --expunge; bazel shutdown; git clean -fdx; git clean -fdx -e 'common/temp' -e '**/node_modules' -e '**/.rush' -e '**/.cache' -e '**/.bazelrc.user' -e '**/bazel-*'; node common/scripts/symlink-node-modules.mjs --clean-node-modules
}

# Start watching X
function startx() {
  cd $HZREPO/apps/project-x/web
  bazel run rspack_bundle_dev.serve --watch
}
alias watchx="startx"

function startnimbus() {
  cd $HZREPO/apps/nimbus/web
  bazel run :rspack_bundle_dev.serve --watch
}

function startai() {
  bazel run //services/ai-assistant-service:start
}

function startaisharp() {
  bazel build //common/bazel:.aspect_rules_js/node_modules/sharp@0.32.6/dir --disk_cache= && startai
}

function freshen() {
  cd $HZREPO
  hz update npm
}

function typecheck() {
  bazel build :typecheck
}

# Freshen dependencies and build X
function freshwatch() {
  freshen &&
  watchx
}

# Prettify everything
function prettify() {
  bazel run :oxfmt
}

# Lint and fix everything
function lintit() {
  bazel run :lint.fix
}

# Lint and fix CSS
function lintcss() {
  bazel run :stylelint
}

# Run tests
function testit() {
  bazel run :vitest.run -- "/$1.spec.js" --coverage.enabled=false
}

# Run a specific test file only
function testonly() {
  bazel run :vitest.run -- "/$1.spec.js" --coverage.enabled=false
}
