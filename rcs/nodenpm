# kill the verdaccio server, switch back to the real npm
function realnpm {
	killall -9 Verdaccio
	resetnpm
}

# reset the npm registry
function resetnpm {
	npm set registry https://registry.npmjs.org/
	yarn config set registry https://registry.yarnpkg.com
}
