function gb() {
  git checkout -b $1
}

function gbl() {
  git branch --sort=-committerdate
}

function gpl() {
  git pull origin $(git rev-parse --abbrev-ref HEAD)
}

# Pull the current branch from origin and rebase
function grb() {
  git pull --rebase origin "$(git symbolic-ref --short HEAD)"
}

# Rebase the current branch onto another branch
function grbonto() {
  git rebase --onto $1 $2 "$(git symbolic-ref --short HEAD)"
}

# Push the current branch to origin using the same name, track it
function gpu() {
  git push -u origin "$(git symbolic-ref --short HEAD)"
}

# Push the current branch to origin using the same name, track it, and don't run verification
function gpunv() {
	git push --no-verify -u origin $(git rev-parse --abbrev-ref HEAD)
}

# diff the given commit against the previous commit
# $1 - commit hash to diff
function gdh() {
	git diff $1~1 $1
}

# edit a commit
# $1 - commit hash edit
function ge() {
	git stash
	git rebase --interactive $1~1
	git stash pop
}

# continue after editing commit
function gec() {
	git stash
	git rebase --continue
}

# fetch and create a branch from origin
function gfb() {
  git fetch origin "$1":"$1"
  git checkout "$1"
}

# undo a merge
function gum() {
  git reset --hard ORIG_HEAD
}

# Find out WTF happened to the passed file
# $1 filepath
git_wtf () {
  git log --full-history -- $1
}

# Delete all local tags and fetch then authoritative copy from the remote
git_clear_tags () {
  git tag -l | xargs git tag -d
  git fetch --tags
}

# Push the current branch to origin using the same name, track it
function gpu() {
  git push -u origin "$(git symbolic-ref --short HEAD)"
}

# Pull the current branch from origin and rebase
function gpr() {
  git pull --rebase origin "$(git symbolic-ref --short HEAD)"
}

# rewrite the given commit to the given timestamp
# $1 commit hash
# $2 timestamp
rewrite_commit_date () {
  local commit="$1" date_timestamp="$2"
  local date temp_branch="temp-rebasing-branch"
  local current_branch="$(git rev-parse --abbrev-ref HEAD)"

  if [[ -z "$commit" ]]; then
      date=`date +'%a, %d %b %Y %H:%M:%S %z'`
  else
      date=`date -r "$date_timestamp" +'%a, %d %b %Y %H:%M:%S %z'`
  fi

  echo $date

  git checkout -b "$temp_branch" "$commit"
  GIT_COMMITTER_DATE="$date" git commit --amend --date "$date"
  git checkout "$current_branch"
  git rebase "$commit" --onto "$temp_branch"
  git branch -d "$temp_branch"
}

# rewrite the given commit to the given timestamp
# $1 old_email
# $2 new_name
# $3 new_email
rewrite_commit_author () {
  local old_email="$1" new_name="$2" new_email="$3" commit="$4"

  FILTER_BRANCH_SQUELCH_WARNING=1 git filter-branch --env-filter '
  WRONG_EMAIL="'"${old_email}"'"
  NEW_NAME="'"${new_name}"'"
  NEW_EMAIL="'"${new_email}"'"

  if [ "$GIT_COMMITTER_EMAIL" = "$WRONG_EMAIL" ]
  then
      export GIT_COMMITTER_NAME="$NEW_NAME"
      export GIT_COMMITTER_EMAIL="$NEW_EMAIL"
  fi
  if [ "$GIT_AUTHOR_EMAIL" = "$WRONG_EMAIL" ]
  then
      export GIT_AUTHOR_NAME="$NEW_NAME"
      export GIT_AUTHOR_EMAIL="$NEW_EMAIL"
  fi
  ' $commit..HEAD -- --branches --tags
}

worktree() {
  # 1. Ensure a branch name was actually provided
  if [ -z "$1" ]; then
    echo "Error: Please provide a branch name."
    echo "Usage: worktree <branch-name>"
    return 1
  fi

  # 2. Get the current directory name
  local repo_name
  repo_name=$(basename "$(pwd)")

  local folder="../${repo_name}-$1"

  # 3. Check if the folder exists, if so, stop
  if [ -e "$folder" ]; then
    echo "Error: Folder '$folder' already exists."
    return 1
  fi

  # 4. Create the worktree with a unique folder name
  if ! git worktree add "$folder" -b "$1"; then
    echo "Error: Failed to create worktree."
    return 1
  fi

  cd $folder || return 1
}

delworktree() {
  # 1. Ensure a branch name was actually provided
  if [ -z "$1" ]; then
    echo "Error: Please provide a branch name."
    echo "Usage: delworktree <branch-name>"
    return 1
  fi

  # 2. Find the worktree for that branch (works from any worktree, any path)
  local folder wt_path line
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) wt_path="${line#worktree }" ;;
      "branch refs/heads/$1") folder="$wt_path" ;;
    esac
  done < <(git worktree list --porcelain)

  if [ -z "$folder" ]; then
    echo "Error: No worktree found for branch '$1'."
    return 1
  fi

  # 3. Never remove the worktree we're standing in
  if [ "$folder" = "$(git rev-parse --show-toplevel)" ]; then
    echo "Error: '$1' is the current worktree. cd elsewhere first."
    return 1
  fi

  # 4. Remove the worktree
  if git worktree remove "$folder" 2>/dev/null; then
    return 0
  fi

  # 5. Removal failed (e.g. submodules present). Only force if everything is clean.
  if [ -n "$(git -C "$folder" status --porcelain 2>/dev/null)" ]; then
    echo "Error: Worktree '$folder' has uncommitted changes. Not removing."
    return 1
  fi

  local sub
  while IFS= read -r sub; do
    [ -z "$sub" ] && continue
    if [ -n "$(git -C "$folder/$sub" status --porcelain 2>/dev/null)" ]; then
      echo "Error: Submodule '$sub' has uncommitted changes. Not removing."
      return 1
    fi
    if [ -n "$(git -C "$folder/$sub" rev-list HEAD --not --remotes 2>/dev/null)" ]; then
      echo "Error: Submodule '$sub' has local commits not on a remote. Not removing."
      return 1
    fi
  done < <(git -C "$folder" submodule foreach --quiet --recursive 'echo $displaypath' 2>/dev/null)

  # 6. Everything is clean, force delete
  if ! git worktree remove --force "$folder"; then
    echo "Error: Failed to remove worktree."
    return 1
  fi
}

worktreelist() {
  git worktree list
}

worktreeunmerged() {
  # Show worktrees whose branch is not merged into the current branch,
  # or which have uncommitted changes (staged, unstaged or untracked)
  local wt_path branch line reason
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) wt_path="${line#worktree }" ;;
      "branch "*)
        branch="${line#branch }"
        # Skip the current branch
        [ "$branch" = "$(git symbolic-ref -q HEAD)" ] && continue
        reason=""
        if ! git merge-base --is-ancestor "$branch" HEAD 2>/dev/null; then
          reason="unmerged"
        fi
        if [ -n "$(git -C "$wt_path" status --porcelain 2>/dev/null)" ]; then
          reason="${reason:+$reason, }uncommitted changes"
        fi
        [ -n "$reason" ] && echo "${wt_path}  [${branch#refs/heads/}] ($reason)"
        ;;
    esac
  done < <(git worktree list --porcelain)
}

worktreecleanup() {
  # Remove all worktrees that worktreeunmerged does not list
  # (branch merged into HEAD and no uncommitted changes).
  # Usage: worktreecleanup [-n]   (-n = dry run)
  local dry=0
  [ "$1" = "-n" ] && dry=1

  local main_wt wt_path branch line blocked
  main_wt=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
  blocked=$(worktreeunmerged)

  while IFS= read -r line; do
    case "$line" in
      "worktree "*) wt_path="${line#worktree }" ;;
      "branch "*)
        branch="${line#branch }"
        [ "$wt_path" = "$main_wt" ] && continue
        [ "$branch" = "$(git symbolic-ref -q HEAD)" ] && continue
        if printf '%s\n' "$blocked" | grep -Fq -- "$wt_path  ["; then
          echo "Skipping $(printf '%s\n' "$blocked" | grep -F -- "$wt_path  [" | head -n1)"
          continue
        fi
        if [ "$dry" = 1 ]; then
          echo "Would remove $wt_path [${branch#refs/heads/}]"
        else
          echo "Removing $wt_path [${branch#refs/heads/}]"
          delworktree "${branch#refs/heads/}"
        fi
        ;;
    esac
  done < <(git worktree list --porcelain)
}
